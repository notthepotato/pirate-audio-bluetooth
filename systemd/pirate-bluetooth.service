[Unit]
Description=Pirate Audio Bluetooth screen, buttons and pairing
Documentation=file://%h/.local/share/pirate-bluetooth/README.md
# Start after Mopidy (if it's there) and so stop before it: at power-off Mopidy's queue can still be read
After=mopidy.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/pirate-bluetooth
ExecStart=%h/.local/share/pirate-bluetooth/venv/bin/python -m pirate_bluetooth
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
