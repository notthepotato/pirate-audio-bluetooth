[Unit]
Description=Pirate Audio music page (upload songs into ~/Music, download them back)
Documentation=file://%h/.local/share/pirate-bluetooth/README.md

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/pirate-bluetooth
ExecStart=/usr/bin/python3 -m pirate_bluetooth.upload
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
